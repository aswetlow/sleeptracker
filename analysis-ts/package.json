{
  "name": "sleeplogger-analysis-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript-Variante der SleepLogger-Auswertung (gleiche Ausgaben wie analysis/*.py)",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "analyze": "tsx src/analyze.ts",
    "ppg": "tsx src/ppg.ts",
    "live": "tsx src/live.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
